# Copy this file to .env.local and fill in the real values.
# .env.local is already in .gitignore — it will never be committed or pushed to GitHub.

# From Batch 0 — you already have these
NEXT_PUBLIC_SUPABASE_URL=https://kqhyjqxnfmrhniujxnec.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tcyF3U4qniHcgHsLttmN8Q_ohbZKoQP

# New for Batch 1 — server-side only, NEVER prefix these with NEXT_PUBLIC_
# or they'd be sent to the browser and anyone could steal them.

# Supabase Dashboard > Settings > API > service_role key (the SECRET one,
# not the anon/publishable key above)
SUPABASE_SERVICE_ROLE_KEY=

# AssemblyAI Dashboard > your API key
ASSEMBLYAI_API_KEY=

# Any random string you make up yourself, e.g. mash your keyboard for 30
# characters. This isn't from any provider — it's a password StoryLens uses
# to confirm that a webhook call genuinely came from AssemblyAI, not from
# someone else who guessed the webhook URL.
ASSEMBLYAI_WEBHOOK_SECRET=
